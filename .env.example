# ==============================================================================
# VisionGuard Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Server Settings
VISIONGUARD_HOST=127.0.0.1
VISIONGUARD_PORT=8000
VISIONGUARD_DEBUG=false
VISIONGUARD_RELOAD=false

# Pipeline Settings
VISIONGUARD_FUSION_MODE=claim_aware
VISIONGUARD_USE_MOCK=false
VISIONGUARD_DEVICE=auto   # 'cuda', 'mps', 'cpu', or 'auto'

# Confidence & Decision Thresholds
VISIONGUARD_SUPPORT_THRESHOLD=0.70
VISIONGUARD_CONTRADICT_THRESHOLD=0.40

# Optional External VLM / LLM API Keys (for live API-based judges)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
